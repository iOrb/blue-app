    "library.startHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Blue what you want to keep. A film, a place, an idea — the collection takes shape with you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dile a Blue qué quieres guardar. Una película, un lugar, una idea… La colección toma forma contigo."
          }
        }
      }
    },
