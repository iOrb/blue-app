    "demo.noteTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A slower kind of Sunday"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un domingo sin prisas"
          }
        }
      }
    },
    "demo.noteBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# A slower kind of Sunday\n\nLeave a little room for the unexpected.\n\n- [ ] Walk without a destination\n- [ ] Find a new bookshop\n- [x] Make good coffee\n\n> Pay attention. The small things are the big things."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " # Un domingo sin prisas\n\nDeja un poco de espacio para lo inesperado.\n\n- [ ] Pasear sin rumbo\n- [ ] Encontrar una librería nueva\n- [x] Preparar un buen café\n\n> Presta atención. Lo pequeño es lo importante."
          }
        }
      }
    },
    "demo.weekendTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places, spaces, ideas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares, espacios, ideas"
          }
        }
      }
    },
    "demo.weekendBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "# Architecture worth a detour\n\n**Barcelona Pavilion** — light, stone, and silence.\n\nLook again at how a room can feel open without being empty.\n\n[Plan a visit](https://miesbcn.com)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " # Arquitectura que merece un desvío\n\n**Pabellón de Barcelona** — luz, piedra y silencio.\n\nVolver a mirar cómo una habitación puede sentirse abierta sin estar vacía.\n\n[Planear una visita](https://miesbcn.com)"
          }
        }
      }
    },
    "demo.interstellar": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A film about distance, time, and the things that bring us home.\n\n**Watch again** for the score."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una película sobre la distancia, el tiempo y lo que nos hace volver a casa.\n\n**Volver a verla** por la banda sonora."
          }
        }
      }
    },
